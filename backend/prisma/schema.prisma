generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String             @id @default(uuid())
  name        String             @db.VarChar(255)
  logo        String?
  email       String             @unique @db.VarChar(255)
  phone       String             @db.VarChar(15)
  address     String
  website     String?            @db.VarChar(255)
  pricingTier PricingTier        @map("pricing_tier")
  seats       Int
  usedSeats   Int                @default(0) @map("used_seats")
  status      OrganizationStatus @default(trial)
  trialEndsAt DateTime?          @map("trial_ends_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  banks       Bank[]
  customers   Customer[]
  dsas        Dsa[]
  invoices    Invoice[]
  users       User[]

  @@index([status])
  @@index([email])
  @@map("organizations")
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique @map("invoice_number") @db.VarChar(50)
  organizationId     String        @map("organization_id")
  amount             Decimal       @db.Decimal(10, 2)
  seats              Int
  pricePerSeat       Decimal       @map("price_per_seat") @db.Decimal(10, 2)
  billingPeriodStart DateTime      @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime      @map("billing_period_end") @db.Date
  dueDate            DateTime      @map("due_date") @db.Date
  status             InvoiceStatus @default(pending)
  paidAt             DateTime?     @map("paid_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model User {
  id                                          String               @id @default(uuid())
  firstName                                   String               @map("first_name") @db.VarChar(100)
  lastName                                    String               @map("last_name") @db.VarChar(100)
  email                                       String               @unique @db.VarChar(255)
  mobile                                      String               @unique @db.VarChar(15)
  passwordHash                                String               @map("password_hash") @db.VarChar(255)
  role                                        UserRole
  isActive                                    Boolean              @default(true) @map("is_active")
  createdAt                                   DateTime             @default(now()) @map("created_at")
  updatedAt                                   DateTime             @updatedAt @map("updated_at")
  createdBy                                   String?              @map("created_by")
  cgstRate                                    Decimal?             @map("cgst_rate") @db.Decimal(5, 2)
  companyAddress                              String?              @map("company_address")
  companyEmail                                String?              @map("company_email") @db.VarChar(255)
  companyGSTIN                                String?              @map("company_gstin") @db.VarChar(15)
  companyName                                 String?              @map("company_name") @db.VarChar(255)
  companyState                                String?              @map("company_state") @db.VarChar(100)
  companyStateCode                            String?              @map("company_state_code") @db.VarChar(2)
  hsnSac                                      String?              @map("hsn_sac") @db.VarChar(10)
  profilePhoto                                String?              @map("profile_photo")
  sgstRate                                    Decimal?             @map("sgst_rate") @db.Decimal(5, 2)
  organizationId                              String?              @map("organization_id")
  customer_remarks                            CustomerRemark[]
  customersAsConnector                        Customer[]           @relation("CustomerConnector")
  customersAsCreator                          Customer[]           @relation("CustomerCreator")
  customersAsLeadOwner                        Customer[]           @relation("CustomerLeadOwner")
  dsaInvoices                                 DsaInvoice[]
  passwordResetTokens                         PasswordResetToken[]
  payoutLedgerAsConnector                     PayoutLedger[]       @relation("PayoutConnector")
  payoutLedgerAsCreator                       PayoutLedger[]       @relation("PayoutCreator")
  payout_pdfs_payout_pdfs_connector_idTousers PayoutPDF[]          @relation("payout_pdfs_connector_idTousers")
  payout_pdfs_payout_pdfs_generated_byTousers PayoutPDF[]          @relation("payout_pdfs_generated_byTousers")
  userBankDetails                             UserBankDetail[]
  users                                       User?                @relation("usersTousers", fields: [createdBy], references: [id])
  other_users                                 User[]               @relation("usersTousers")
  organization                                Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications                               Notification[]

  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@index([createdBy])
  @@map("users")
}

model Customer {
  id                  String           @id @default(uuid())
  name                String           @db.VarChar(255)
  mobile              String           @db.VarChar(15)
  email               String?          @db.VarChar(255)
  loanType            LoanType         @map("loan_type")
  loanAmount          Decimal          @map("loan_amount") @db.Decimal(15, 2)
  connectorId         String?          @map("connector_id")
  leadOwner           String?          @map("lead_owner")
  salesManager        String?          @map("sales_manager") @db.VarChar(255)
  status              LoanStatus
  applicationDate     DateTime         @default(now()) @map("application_date") @db.Date
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  applicationId       String?          @unique @map("application_id") @db.VarChar(50)
  bankId              String?          @map("bank_id")
  caseType            CaseType?        @map("case_type")
  createdBy           String?          @map("created_by")
  currentAddress      String?          @map("current_address")
  currentCompany      String?          @map("current_company") @db.VarChar(255)
  current_company_exp String?          @db.VarChar(50)
  date_of_birth       DateTime?        @db.Date
  dsaId               String?          @map("dsa_id")
  homeType            String?          @map("home_type") @db.VarChar(50)
  motherName          String?          @map("mother_name") @db.VarChar(255)
  nomineeDateOfBirth  DateTime?        @map("nominee_date_of_birth") @db.Date
  nomineeName         String?          @map("nominee_name") @db.VarChar(255)
  nomineeRelation     String?          @map("nominee_relation") @db.VarChar(100)
  officialEmail       String?          @map("official_email") @db.VarChar(255)
  panNo               String?          @map("pan_no") @db.VarChar(10)
  pdfUrl              String?          @map("pdf_url")
  personalEmail       String?          @map("personal_email") @db.VarChar(255)
  postalAddress       String?          @map("postal_address")
  reference1Address   String?          @map("reference1_address")
  reference1Mobile    String?          @map("reference1_mobile") @db.VarChar(15)
  reference1Name      String?          @map("reference1_name") @db.VarChar(255)
  reference2Address   String?          @map("reference2_address")
  reference2Mobile    String?          @map("reference2_mobile") @db.VarChar(15)
  reference2Name      String?          @map("reference2_name") @db.VarChar(255)
  spouseName          String?          @map("spouse_name") @db.VarChar(255)
  totalWorkExperience String?          @map("total_work_experience") @db.VarChar(50)
  qualification       String?          @map("qualification") @db.VarChar(100)
  maritalStatus       String?          @map("marital_status") @db.VarChar(20)
  tenure              String?          @map("tenure") @db.VarChar(50)
  companyAddress      String?          @map("company_address")
  organizationId      String?          @map("organization_id")
  location            String?          @map("location") @db.VarChar(255)
  subventionAmount    Decimal?         @map("subvention_amount") @db.Decimal(15, 2)
  remarks             CustomerRemark[]
  bank                Bank?            @relation(fields: [bankId], references: [id])
  connector           User?            @relation("CustomerConnector", fields: [connectorId], references: [id])
  creator             User?            @relation("CustomerCreator", fields: [createdBy], references: [id])
  dsa                 Dsa?             @relation(fields: [dsaId], references: [id])
  leadOwnerUser       User?            @relation("CustomerLeadOwner", fields: [leadOwner], references: [id])
  organization        Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([applicationDate])
  @@index([bankId])
  @@index([connectorId])
  @@index([createdBy])
  @@index([dsaId])
  @@index([leadOwner])
  @@index([organizationId])
  @@index([status])
  @@map("customers")
}

model Bank {
  id              String           @id @default(uuid())
  name            String           @db.VarChar(255)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  organizationId  String?          @map("organization_id")
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers       Customer[]
  dsaBankDetails  DsaBankDetail[]
  userBankDetails UserBankDetail[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("banks")
}

model Dsa {
  id             String          @id @default(uuid())
  name           String          @db.VarChar(255)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  address        String?
  city           String?         @db.VarChar(100)
  companyName    String?         @map("company_name") @db.VarChar(255)
  email          String?         @db.VarChar(255)
  gstin          String?         @db.VarChar(15)
  pinCode        String?         @map("pin_code") @db.VarChar(6)
  stateCode      String?         @map("state_code") @db.VarChar(2)
  stateName      String?         @map("state_name") @db.VarChar(100)
  organizationId String?         @map("organization_id")
  customers      Customer[]
  bankDetails    DsaBankDetail[]
  invoices       DsaInvoice[]
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("dsas")
}

model DsaBankDetail {
  id          String   @id @default(uuid())
  dsaId       String   @map("dsa_id")
  bankId      String   @map("bank_id")
  loanType    LoanType @map("loan_type")
  payoutRatio Decimal  @map("payout_ratio") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  bank        Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  dsa         Dsa      @relation(fields: [dsaId], references: [id], onDelete: Cascade)

  @@unique([dsaId, bankId, loanType])
  @@index([dsaId])
  @@map("dsa_bank_details")
}

model UserBankDetail {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  bankId      String   @map("bank_id")
  loanType    LoanType @map("loan_type")
  payoutRatio Decimal  @map("payout_ratio") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  bank        Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankId, loanType])
  @@index([userId])
  @@index([bankId])
  @@map("user_bank_details")
}

model PayoutLedger {
  id          String   @id @default(uuid())
  connectorId String   @map("connector_id")
  customerId  String?  @map("customer_id")
  entry_type  String
  amount      Decimal  @db.Decimal(15, 2)
  description String
  month       Int
  year        Int
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  connector   User     @relation("PayoutConnector", fields: [connectorId], references: [id], onDelete: Cascade)
  creator     User?    @relation("PayoutCreator", fields: [createdBy], references: [id])

  @@index([connectorId])
  @@index([connectorId, month, year])
  @@index([entry_type])
  @@map("payout_ledger")
}

model PayoutPDF {
  id                                    String   @id @default(uuid())
  connector_id                          String
  month                                 Int
  year                                  Int
  pdfUrl                                String   @map("pdf_url")
  generated_by                          String
  createdAt                             DateTime @default(now()) @map("created_at")
  users_payout_pdfs_connector_idTousers User     @relation("payout_pdfs_connector_idTousers", fields: [connector_id], references: [id], onDelete: Cascade)
  users_payout_pdfs_generated_byTousers User     @relation("payout_pdfs_generated_byTousers", fields: [generated_by], references: [id])

  @@unique([connector_id, month, year])
  @@index([connector_id])
  @@map("payout_pdfs")
}

model DsaInvoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(50)
  dsaId         String   @map("dsa_id")
  issuedById    String   @map("issued_by_id")
  invoiceDate   DateTime @map("invoice_date") @db.Date
  period_month  Int
  period_year   Int
  taxableAmount Decimal  @map("taxable_amount") @db.Decimal(15, 2)
  cgstRate      Decimal  @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount    Decimal  @map("cgst_amount") @db.Decimal(15, 2)
  sgstRate      Decimal  @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount    Decimal  @map("sgst_amount") @db.Decimal(15, 2)
  roundOff      Decimal  @map("round_off") @db.Decimal(10, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(15, 2)
  hsnSac        String   @map("hsn_sac") @db.VarChar(10)
  pdfUrl        String?  @map("pdf_url")
  status        String   @default("issued") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  dsa           Dsa      @relation(fields: [dsaId], references: [id], onDelete: Cascade)
  issuedBy      User     @relation(fields: [issuedById], references: [id])

  @@index([dsaId])
  @@index([invoiceDate])
  @@map("dsa_invoices")
}

model CustomerRemark {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  remark     String
  created_by String?
  createdAt  DateTime @default(now()) @map("created_at")
  users      User?    @relation(fields: [created_by], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_remarks")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

model Notification {
  id             String           @id @default(uuid())
  type           NotificationType
  title          String           @db.VarChar(255)
  message        String
  userId         String           @map("user_id")
  customerId     String?          @map("customer_id")
  isRead         Boolean          @default(false) @map("is_read")
  createdAt      DateTime         @default(now()) @map("created_at")
  organizationId String?          @map("organization_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([organizationId])
  @@map("notifications")
}

enum UserRole {
  superadmin
  admin
  backoffice
  connector
  master_admin
}

enum OrganizationStatus {
  trial
  active
  suspended
}

enum InvoiceStatus {
  draft
  pending
  paid
  overdue
  cancelled
}

enum PricingTier {
  starter
  professional
  enterprise
}

enum LoanStatus {
  login
  rejected
  approved
  disbursed
  hold
  relook
  drop
}

enum LoanType {
  PL
  HL
  BL
}

enum CaseType {
  fresh
  bt
  bt_topup
}

enum NotificationType {
  new_lead
  remark_added
  status_change
}
