// Payout Ledger (Financial transactions for connector payouts)
model PayoutLedger {
  id              String   @id @default(uuid())
  customerId      String   @map("customer_id")
  connectorId     String   @map("connector_id")
  transactionType String   @map("transaction_type") @db.VarChar(20) // 'debit' or 'credit'
  amount          Decimal  @db.Decimal(15, 2)
  balance         Decimal  @db.Decimal(15, 2)
  narration       String   @db.Text
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  connector User     @relation("PayoutConnector", fields: [connectorId], references: [id])
  creator   User     @relation("PayoutCreator", fields: [createdBy], references: [id])

  @@index([customerId])
  @@index([connectorId])
  @@index([createdAt])
  @@map("payout_ledger")
}

// Payout PDF Records
model PayoutPDF {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  pdfUrl      String   @map("pdf_url") @db.Text
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  totalAmount Decimal  @map("total_amount") @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("payout_pdfs")
}

// DSA Invoices (GST-compliant invoices for DSA commissions)
model DsaInvoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(50)
  dsaId         String   @map("dsa_id")
  invoiceDate   DateTime @map("invoice_date") @db.Date
  issuedById    String   @map("issued_by_id")

  // Invoice amounts
  taxableAmount Decimal @map("taxable_amount") @db.Decimal(15, 2)
  cgstRate      Decimal @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount    Decimal @map("cgst_amount") @db.Decimal(15, 2)
  sgstRate      Decimal @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount    Decimal @map("sgst_amount") @db.Decimal(15, 2)
  roundOff      Decimal @map("round_off") @db.Decimal(10, 2)
  totalAmount   Decimal @map("total_amount") @db.Decimal(15, 2)
  hsnSac        String  @map("hsn_sac") @db.VarChar(10)

  pdfUrl    String?  @map("pdf_url")
  status    String   @default("issued") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  dsa      Dsa  @relation(fields: [dsaId], references: [id], onDelete: Cascade)
  issuedBy User @relation(fields: [issuedById], references: [id])

  @@index([dsaId])
  @@index([invoiceDate])
  @@map("dsa_invoices")
}

