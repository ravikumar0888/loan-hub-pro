// ==================== MULTI-TENANCY MODELS ====================

// Organizations Table (Multi-Tenant Parent)
model Organization {
  id          String             @id @default(uuid())
  name        String             @db.VarChar(255)
  logo        String?            @db.Text
  email       String             @unique @db.VarChar(255)
  phone       String             @db.VarChar(15)
  address     String             @db.Text
  website     String?            @db.VarChar(255)
  pricingTier PricingTier        @map("pricing_tier")
  seats       Int // Total purchased seats
  usedSeats   Int                @default(0) @map("used_seats") // Current active users
  status      OrganizationStatus @default(trial)
  trialEndsAt DateTime?          @map("trial_ends_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Relations
  users     User[]
  customers Customer[]
  banks     Bank[]
  dsas      Dsa[]
  invoices  Invoice[]

  @@index([status])
  @@index([email])
  @@map("organizations")
}

// Subscription Invoices Table (for billing organizations)
model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique @map("invoice_number") @db.VarChar(50)
  organizationId     String        @map("organization_id")
  amount             Decimal       @db.Decimal(10, 2)
  seats              Int // Number of seats billed
  pricePerSeat       Decimal       @map("price_per_seat") @db.Decimal(10, 2)
  billingPeriodStart DateTime      @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime      @map("billing_period_end") @db.Date
  dueDate            DateTime      @map("due_date") @db.Date
  status             InvoiceStatus @default(pending)
  paidAt             DateTime?     @map("paid_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

